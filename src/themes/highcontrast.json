      "--bg-modal-overlay": "rgba(255, 255, 255, 0.85)",
      "--text-primary": "#000000",
      "--text-secondary": "#1F1F1F",
      "--text-color": "var(--text-primary)",
      "--border-color": "#000000",
      "--whatsapp-bg": "#FFFFFF",
      "--whatsapp-green": "#00318C",
      "--whatsapp-green-hover": "#001F5C",
      "--bg-surface": "var(--bg-sidebar)",
      "--accent-color": "var(--bg-active)",
      "--accent-hover": "var(--whatsapp-green-hover)",
      "--text-on-accent": "#ffffff",
      "--accent-secondary": "#0052cc",
      "--accent-terracotta": "#993d00",
      "--accent-crimson": "#990000"
    }
  }
}
