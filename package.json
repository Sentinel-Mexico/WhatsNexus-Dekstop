{
  "name": "whatsnexus",
  "version": "2.2.5",
  "description": "Multi-account WhatsApp Web client using Electron",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "download-doom": "node scripts/download-doom.js",
    "postinstall": "node scripts/download-doom.js"
  },
  "author": {
    "name": "Sentinel Studio",
    "email": "studio@somossentinel.com"
  },
  "license": "GPL-3.0-or-later",
  "build": {
    "appId": "com.sentinelstudio.whatsnexus",
    "productName": "WhatsNexus",
    "artifactName": "whatsnexus-${version}-${os}-${arch}.${ext}",
    "icon": "src/assets/img/icon.png",
    "afterAllArtifactBuild": "scripts/generate-msix.js",
    "files": [
      "src/**/*",
      "src/assets/**/*",
      "src/themes/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network"
    },
    "snap": {
      "grade": "stable",
      "confinement": "strict",
      "plugs": [
        "default",
        "network",
        "network-bind",
        "desktop",
        "desktop-legacy",
        "x11",
        "wayland",
        "unity7",
        "audio-playback",
        "pulseaudio",
        "browser-support"
      ]
    },
    "pacman": {
      "compression": "xz",
      "packageName": "whatsnexus",
      "packageCategory": "Network"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.social-networking"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appx": {
      "identityName": "SentinelMexico.WhatsNexus",
      "applicationId": "WhatsNexus",
      "displayName": "WhatsNexus Desktop",
      "publisherDisplayName": "Sentinel Mexico",
      "publisher": "CN=SentinelMexico",
      "languages": [
        "es-ES",
        "en-US"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sentinel-Mexico",
        "repo": "WhatsNexus-Dekstop"
      }
    ]
  },
  "devDependencies": {
    "electron": "^43.6.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  },
  "allowScripts": {
    "electron@43.6.0": true,
    "electron": true
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  }
}
